{
  "name": "document-proof",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @document-proof/web dev",
    "build": "pnpm --filter @document-proof/web build",
    "typecheck": "pnpm --filter @document-proof/web typecheck",
    "contracts:build": "forge build --root contracts && node scripts/export-abi.mjs",
    "contracts:test": "forge test --root contracts -vv",
    "test": "node --test scripts/*.test.mjs",
    "test:integration": "node scripts/integration.mjs",
    "chain": "anvil --port 8547 --chain-id 31337 --host 127.0.0.1",
    "seed": "pnpm contracts:build && node scripts/deploy-local.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "pnpm contracts:test && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "prettier": "3.6.2"
  },
  "dependencies": {
    "viem": "2.57.3"
  }
}
